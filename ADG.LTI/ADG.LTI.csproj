<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>ADG.LTI</AssemblyName>
        <RootNamespace>ADG.LTI</RootNamespace>
        <ApplicationIcon>..\ADG.Website\wwwroot\favicon.ico</ApplicationIcon>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AGX.Common.Logging.Serilog" />
        <PackageReference Include="FluentValidation"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Microsoft.IdentityModel.Tokens"/>
        <PackageReference Include="Scalar.AspNetCore"/>
        <PackageReference Include="Scalar.AspNetCore.Microsoft"/>
        <PackageReference Include="System.IdentityModel.Tokens.Jwt"/>
        <PackageReference Include="System.Text.Json"/>
        <PackageReference Include="Serilog.AspNetCore"/>
        <PackageReference Include="FluentResults"/>
        <PackageReference Include="AGX.Common.Options.Validation"/>
        <PackageReference Include="Roslynator.Analyzers"/>
        <PackageReference Include="SonarAnalyzer.CSharp"/>
    </ItemGroup>

    <ItemGroup>

        <ProjectReference Include="..\ADG.Server.ServiceDefaults\ADG.Server.ServiceDefaults.csproj" />
        <ProjectReference Include="..\ADG.Server.Shared\ADG.Server.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\ADG.Website\wwwroot\favicon.ico">
        <Link>favicon.ico</Link>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\ADG.Server.Shared\appsettings.Shared.json">
        <Link>appsettings.Shared.json</Link>
      </Content>
      <Content Include="..\ADG.Server.Shared\appsettings.Shared.Production.json">
        <Link>appsettings.Shared.Production.json</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="wwwroot\.well-known\jwks.json" />
      <_ContentIncludedByDefault Remove="wwwroot\.well-known\openid-configuration" />
    </ItemGroup>

</Project>
