{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "ADG.LTI": "Information"
    }
  },
  "Observability": {
      "ServiceName": "ADG.LtiApi",
      "CollectorUrl": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "LTI": {
    "ClientId": "b4DdwmxZQ4ICwXy", // Given by Moodle after we add the tool
    "DeploymentId": "3",
    "MoodleAuthorizationEndpoint": "https://localhost/mod/lti/auth.php",
    "RedirectionUrl": "https://localhost:7175/lti/launch", // Must match the applicationUrl of ADG.LTI in launchSettings.json
    "Issuer": "https://localhost",
    "JwksUrl": "https://localhost/mod/lti/certs.php",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateSignature": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lti-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
